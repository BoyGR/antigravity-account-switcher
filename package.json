{
    "name": "antigravity-account-switcher",
    "displayName": "Antigravity Account Switcher",
    "description": "Manage and switch Google accounts used by Google Antigravity in Visual Studio Code through Antigravity's existing authentication flow.",
    "version": "1.2.0",
    "publisher": "boygr",
    "author": {
        "name": "Boy Gilang Ramadhan",
        "url": "https://boygr.com"
    },
    "license": "MIT",
    "icon": "media/icon.png",
    "homepage": "https://boygr.com",
    "bugs": {
        "url": "https://github.com/BoyGR/antigravity-account-switcher/issues"
    },
    "galleryBanner": {
        "color": "#090d16",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.95.0"
    },
    "categories": [
        "Other",
        "Machine Learning"
    ],
    "activationEvents": [
        "onCommand:boygr.antigravityAccountSwitcher.diagnose",
        "onCommand:boygr.antigravityAccountSwitcher.status",
        "onCommand:boygr.antigravityAccountSwitcher.inspectBridge",
        "onCommand:boygr.antigravityAccountSwitcher.authStatus",
        "onCommand:boygr.antigravityAccountSwitcher.signIn",
        "onCommand:boygr.antigravityAccountSwitcher.reAuth",
        "onCommand:boygr.antigravityAccountSwitcher.signOut",
        "onCommand:boygr.antigravityAccountSwitcher.currentAccount",
        "onCommand:boygr.antigravityAccountSwitcher.saveCurrentAccount",
        "onCommand:boygr.antigravityAccountSwitcher.manageAccounts",
        "onView:boygr.antigravityAccountSwitcher.accountsView",
        "onCommand:boygr.antigravityAccountSwitcher.addAccount",
        "onCommand:boygr.antigravityAccountSwitcher.statusBarMenu"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "boygr.antigravityAccountSwitcher.diagnose",
                "title": "Diagnose",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.status",
                "title": "Status",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.inspectBridge",
                "title": "Inspect Bridge",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.authStatus",
                "title": "Auth Status",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.signIn",
                "title": "Sign In",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.reAuth",
                "title": "Re-auth",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.signOut",
                "title": "Sign Out",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.currentAccount",
                "title": "Current Account",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.saveCurrentAccount",
                "title": "Save Current Account",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.manageAccounts",
                "title": "Manage Accounts",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.refreshAccountsView",
                "title": "Refresh",
                "icon": "$(refresh)",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.addAccount",
                "title": "Add / Switch Google Account",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.switchAccount",
                "title": "Switch Account",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.diagnose",
                "title": "Diagnose Antigravity",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.editAccountLabel",
                "title": "Edit Account Label",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.removeSavedAccount",
                "title": "Remove from Saved Accounts",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.openSettings",
                "title": "Settings",
                "category": "Antigravity Account Switcher",
                "icon": "$(gear)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.statusBarMenu",
                "title": "Status Bar Menu",
                "category": "Antigravity Account Switcher"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.exportAccounts",
                "title": "Export Saved Accounts...",
                "category": "Antigravity Account Switcher",
                "icon": "$(export)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.importAccounts",
                "title": "Import Saved Accounts...",
                "category": "Antigravity Account Switcher",
                "icon": "$(import)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.reconnectHub",
                "title": "Reconnect Antigravity Hub",
                "category": "Antigravity Account Switcher",
                "icon": "$(plug)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.restartBackend",
                "title": "Restart Backend Process",
                "category": "Antigravity Account Switcher",
                "icon": "$(debug-restart)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.setWorkspaceAccount",
                "title": "Set Default Account for Workspace...",
                "category": "Antigravity Account Switcher",
                "icon": "$(folder-active)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.clearWorkspaceAccount",
                "title": "Clear Default Account for Workspace",
                "category": "Antigravity Account Switcher",
                "icon": "$(folder)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.exportQuotaAnalytics",
                "title": "Export Quota Analytics (CSV/JSON)...",
                "category": "Antigravity Account Switcher",
                "icon": "$(graph)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.quotaOverview",
                "title": "View Multi-Account Quota Matrix...",
                "category": "Antigravity Account Switcher",
                "icon": "$(dashboard)"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.clearTokenVault",
                "title": "Clear Stored Token Vault...",
                "category": "Antigravity Account Switcher",
                "icon": "$(key)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "antigravityAccounts",
                    "title": "Antigravity Account Switcher",
                    "icon": "media/antigravity.svg"
                }
            ]
        },
        "views": {
            "antigravityAccounts": [
                {
                    "id": "boygr.antigravityAccountSwitcher.accountsView",
                    "name": "Antigravity Account Switcher",
                    "type": "webview",
                    "contextualTitle": "Antigravity Account Switcher"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "boygr.antigravityAccountSwitcher.refreshAccountsView",
                    "when": "view == boygr.antigravityAccountSwitcher.accountsView",
                    "group": "navigation@1"
                },
                {
                    "command": "boygr.antigravityAccountSwitcher.quotaOverview",
                    "when": "view == boygr.antigravityAccountSwitcher.accountsView",
                    "group": "navigation@2"
                },
                {
                    "command": "boygr.antigravityAccountSwitcher.openSettings",
                    "when": "view == boygr.antigravityAccountSwitcher.accountsView",
                    "group": "navigation@3"
                }
            ]
        },
        "keybindings": [
            {
                "command": "boygr.antigravityAccountSwitcher.statusBarMenu",
                "key": "alt+a",
                "mac": "cmd+alt+a"
            },
            {
                "command": "boygr.antigravityAccountSwitcher.refreshAccountsView",
                "key": "alt+shift+a",
                "mac": "cmd+alt+shift+a"
            }
        ],
        "configuration": {
            "title": "Antigravity Account Switcher",
            "properties": {
                "boygr.antigravityAccountSwitcher.autoRefreshIntervalMinutes": {
                    "type": "integer",
                    "default": 5,
                    "enum": [
                        0,
                        1,
                        5,
                        15,
                        30,
                        60
                    ],
                    "enumDescriptions": [
                        "Off (Manual only)",
                        "Every 1 minute",
                        "Every 5 minutes (Recommended)",
                        "Every 15 minutes",
                        "Every 30 minutes",
                        "Every 1 hour"
                    ],
                    "description": "Interval in minutes to automatically refresh quota for the active Antigravity account (0 to disable)."
                },
                "boygr.antigravityAccountSwitcher.enableLowQuotaReminder": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show a notification alert when remaining quota drops below the warning threshold."
                },
                "boygr.antigravityAccountSwitcher.lowQuotaThresholdPercent": {
                    "type": "integer",
                    "default": 20,
                    "enum": [
                        5,
                        10,
                        15,
                        20,
                        25,
                        30
                    ],
                    "description": "Remaining quota percentage threshold that triggers a low quota warning notification."
                },
                "boygr.antigravityAccountSwitcher.smartQuotaFallback": {
                    "type": "boolean",
                    "default": true,
                    "description": "Suggest a 1-click switch to your saved account with the highest remaining quota when active quota is low."
                },
                "boygr.antigravityAccountSwitcher.notifyQuotaReset": {
                    "type": "boolean",
                    "default": true,
                    "description": "Notify when a low or exhausted account's quota reset window has finished and quota is restored."
                },
                "boygr.antigravityAccountSwitcher.autoSwitchOnExhaustion": {
                    "type": "boolean",
                    "default": true,
                    "description": "Suggest an immediate 1-click switch to your best available backup account when active quota is completely exhausted (0%)."
                },
                "boygr.antigravityAccountSwitcher.autoRoundRobin": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically rotate to the best available backup account when active account hits rate limit (0% remaining)."
                },
                "boygr.antigravityAccountSwitcher.enableQuotaAudio": {
                    "type": "boolean",
                    "default": true,
                    "description": "Play subtle synthesized audio chimes when quota resets or reaches critical low thresholds."
                },
                "boygr.antigravityAccountSwitcher.enableInstantSwitch": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable instant account switching without opening the browser by securely caching credentials in the Token Vault."
                },
                "boygr.antigravityAccountSwitcher.autoPromptWorkspaceAccount": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically prompt to switch to the linked account when opening a project workspace."
                },
                "boygr.antigravityAccountSwitcher.autoSyncOfficialUi": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically synchronize Antigravity's official sidebar after switching accounts or modifying authentication."
                },
                "boygr.antigravityAccountSwitcher.showStatusBarItem": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show Antigravity active account quota indicator in the status bar."
                },
                "boygr.antigravityAccountSwitcher.statusBarFormat": {
                    "type": "string",
                    "default": "compact",
                    "enum": [
                        "compact",
                        "detailed",
                        "percentageOnly"
                    ],
                    "enumDescriptions": [
                        "Compact (e.g. AGY: 85%)",
                        "Detailed with countdown (e.g. AGY: 85% (1h 45m))",
                        "Percentage only (e.g. 85%)"
                    ],
                    "description": "Display format for the Antigravity quota indicator in the status bar."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./ --noEmit && node esbuild.js --production",
        "watch": "node esbuild.js --watch",
        "package": "vsce package",
        "vscode:prepublish": "npm run compile",
        "package:vsix": "npx --yes @vscode/vsce package",
        "publish:marketplace": "npx --yes @vscode/vsce publish",
        "publish:openvsx": "npx --yes ovsx publish"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/vscode": "^1.95.0",
        "@vscode/vsce": "^3.6.0",
        "esbuild": "^0.28.2",
        "typescript": "^5.9.0"
    },
    "keywords": [
        "antigravity",
        "google",
        "account",
        "account-switcher",
        "vscode"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/BoyGR/antigravity-account-switcher.git"
    }
}
